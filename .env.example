# Copy to .env locally. Never commit real tokens.
# The echo example loads this file with `node --env-file=../../.env`.

# Telegram Bot API (long polling)
TELEGRAM_BOT_TOKEN=
# Alias accepted by the echo example
# IMWIRE_TELEGRAM_BOT_TOKEN=
# Optional override; defaults to the bot id from getMe
TELEGRAM_ACCOUNT_ID=

# Feishu / Lark app (WebSocket long connection)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu (China) or lark (international). Default: feishu
FEISHU_DOMAIN=feishu

# Week 2 assistant (session + pi)
# accountId must match the adapter: Telegram defaults to "telegram" (or TELEGRAM_ACCOUNT_ID);
# Feishu defaults to FEISHU_APP_ID. Format: platform:accountId:userId[,name] ;-separated
# IMWIRE_ALLOWLIST=telegram:telegram:111111111,Owner
# IMWIRE_DB=./imwire.sqlite
# IMWIRE_USE_PI=1
# IMWIRE_PI_PROVIDER=openai
# IMWIRE_PI_MODEL=gpt-4o-mini
# IMWIRE_SYSTEM_PROMPT=You are a helpful assistant.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
