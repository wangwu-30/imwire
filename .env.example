# Copy to .env locally. Never commit real tokens.
# The echo example loads this file with `node --env-file=../../.env`.

# `imwire serve` requires an explicit adapter list. Tokens alone are ignored.
# IMWIRE_ADAPTERS=telegram,feishu,dingtalk,wecom,slack
# WebSocket token for `imwire serve --ws` (generated and printed to stderr if unset)
# IMWIRE_WS_TOKEN=

# Telegram Bot API (long polling)
TELEGRAM_BOT_TOKEN=
# Alias accepted by the echo example
# IMWIRE_TELEGRAM_BOT_TOKEN=
# Recommended stable id. After start(), getMe only rewrites accountId when it is
# unset or exactly "telegram" (it becomes the bot numeric id = token prefix).
TELEGRAM_ACCOUNT_ID=mybot

# Feishu / Lark app (WebSocket long connection)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu (China) or lark (international). Default: feishu
FEISHU_DOMAIN=feishu

# DingTalk Stream robot (unverified against a live org in this repo)
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_ROBOT_CODE=
# DINGTALK_CARD_TEMPLATE_ID=
# DINGTALK_CARD_STREAM_KEY=content
# DINGTALK_ACCOUNT_ID=

# WeCom 智能机器人 long-connection (reply-only; unverified live)
# WECOM_BOT_ID=
# WECOM_SECRET=
# WECOM_ACCOUNT_ID=
# Optional JSON persist for inbound req_id (official 24h reply window).
# Without this, a restart cannot reply until the next inbound.
# LRU is memory-bounded (default 1 MiB / 1048576 bytes); older-than-TTL
# slots drop first, then least-recently-used keys even if still in-window.
# WECOM_REPLY_STORE=./wecom-reply.json
# WECOM_REPLY_MAX_BYTES=1048576

# Slack Socket Mode (unverified live; needs xoxb- + xapp- with connections:write)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ACCOUNT_ID=

# Week 2 assistant (session + pi)
# accountId must match the running adapter (three exact segments).
# Recommended: TELEGRAM_ACCOUNT_ID=mybot and telegram:mybot:<uid>,Owner
# Alternative: leave TELEGRAM_ACCOUNT_ID unset; after start()/getMe, accountId is
# the bot numeric id (digits before the first colon in TELEGRAM_BOT_TOKEN).
# Then IMWIRE_ALLOWLIST=telegram:<botId>:<uid>,Owner
# Do NOT use telegram:telegram:<uid> — getMe rewrites "telegram" to the bot id.
# Feishu defaults to FEISHU_APP_ID. Format: platform:accountId:userId[,name]
# IMWIRE_ALLOWLIST=telegram:mybot:111111111,Owner
# IMWIRE_DB=./imwire.sqlite
# IMWIRE_USE_PI=1
# IMWIRE_PI_PROVIDER=openai
# IMWIRE_PI_MODEL=gpt-4o-mini
# IMWIRE_SYSTEM_PROMPT=You are a helpful assistant.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
