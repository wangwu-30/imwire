{
  "name": "imwire-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:echo": "pnpm --filter @imwire/example-echo start",
    "example:assistant": "pnpm --filter @imwire/example-assistant start"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "protobufjs", "better-sqlite3"]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.8",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
